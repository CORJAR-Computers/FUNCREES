# ============================================
# FUNCREES Colombia — Variables de Entorno
# ============================================
# Copia este archivo como .env y completa los valores
# cp .env.example .env
# ============================================

# --- DJANGO ---
# Modo debug (False en producción, True solo para desarrollo local)
DEBUG=False

# Clave secreta de Django — Genera una nueva con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=genera-una-clave-unica-aqui

# Hosts permitidos separados por coma (sin espacios)
# Ejemplo: funcreescolombia.org,www.funcreescolombia.org,localhost
ALLOWED_HOSTS=funcreescolombia.org,www.funcreescolombia.org,localhost,127.0.0.1

# --- BASE DE DATOS ---
# Para desarrollo local (SQLite):
# DATABASE_URL=sqlite:///db.sqlite3
#
# Para producción con PostgreSQL:
# Formato: postgresql://usuario:password@host:puerto/nombre_bd
DATABASE_URL=postgresql://funcrees_user:tu_password_segura@localhost:5432/funcrees_db

# --- CACHE (recomendado en producción multi-worker) ---
# Django usa caché por proceso (locmem) por defecto: con Gunicorn en N workers
# los límites de donaciones/contacto por hora se multiplican por N.
# Para un límite REAL compartido entre workers usa la base de datos:
#   CACHE_BACKEND=db
# y ejecuta una sola vez tras el deploy:
#   python manage.py createcachetable
CACHE_BACKEND=locmem

# --- CORS ---
# Orígenes permitidos para CORS (separados por coma, sin espacios)
# Ejemplo: https://funcreescolombia.org,https://www.funcreescolombia.org,http://localhost:5500
CORS_ALLOWED_ORIGINS=https://funcreescolombia.org,https://www.funcreescolombia.org

# --- FRONTEND ---
# URL del frontend (para redirecciones de pago y enlaces en emails)
FRONTEND_URL=https://funcreescolombia.org

# --- EMAIL (SMTP) ---
# Usando Gmail como ejemplo — recomiendo SendGrid, Mailgun o el servicio de Hostinger
DEFAULT_FROM_EMAIL=contacto@funcreescolombia.org
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=tu-contraseña-de-aplicacion
EMAIL_USE_TLS=True

# --- WOMPI (Pasarela de Pagos) ---
# Ambiente: 'sandbox' para pruebas, 'production' para producción real
WOMPI_ENV=sandbox

# Obtén tus llaves en: https://wompi.co
WOMPI_PUBLIC_KEY=pub_prod_xxxxxxxxxxxxxxxxxxxx
WOMPI_PRIVATE_KEY=prv_prod_xxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=prod_integrity_xxxxxxxxxxxx

# --- ENCRIPTACIÓN (Fernet - Ley 1581 Habeas Data) ---
# Genera una clave con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=tu-clave-fernet-de-44-caracteres-base64-aqui

# --- RESUMEN SEMANAL ---
# Destinatarios del correo semanal con las cifras de la Fundacion (lunes 7 am)
# Separados por coma. Dejar vacio desactiva el envio.
DIGEST_TO=

# --- MONITOR DE DISPONIBILIDAD (check_uptime, cron cada 5 min) ---
# Destinatarios de las alertas de caida. Si queda vacio se usa DIGEST_TO.
UPTIME_ALERT_TO=

# URLs verificadas por el monitor. Por defecto son internas del VPS (el
# comando corre en el propio servidor). Si prefieres probar el dominio
# publico (incluye DNS/SSL/Nginx en el chequeo), usa:
#   UPTIME_BACKEND_URL=https://funcreescolombia.org/api/health/
#   UPTIME_FRONTEND_URL=https://funcreescolombia.org/
UPTIME_BACKEND_URL=http://127.0.0.1:8000/api/health/
UPTIME_FRONTEND_URL=http://127.0.0.1:3000/

# Antirruido: fallos consecutivos antes de declarar caida (2 x 5 min = ~10 min)
UPTIME_FALLOS_PARA_ALERTA=2
# Horas entre recordatorios mientras un servicio siga caido
UPTIME_REMINDER_HOURS=2
# Segundos de espera por respuesta
UPTIME_TIMEOUT=10

# Opcional (recomendado): heartbeat externo contra healthchecks.io — si el VPS
# entero se cae, ni el monitor ni el correo podran ejecutarse; el servicio
# externo detecta el silencio y avisa por su cuenta. Crea un check gratuito en
# https://healthchecks.io y pega aqui su URL de ping.
UPTIME_HEARTBEAT_URL=
