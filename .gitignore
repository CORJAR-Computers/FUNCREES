# Clave Fernet de desarrollo (generada automáticamente por settings.py cuando
# DEBUG=True y no hay ENCRYPTION_KEY en .env). NO debe subirse a git: contiene
# el secreto que cifra datos sensibles (donante_documento, teléfono, tokens).
backend/.dev_key

# ─── Environment ──────────────────────────
.env
.env.local
.env.production
.env.backup-*
!backend/.env.example

# ─── IDE / Editors ────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

