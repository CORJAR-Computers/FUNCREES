# ─── Python ────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.egg-info/
dist/
build/
*.egg
.eggs/

# ─── Virtual Environment ──────────────────
venv/
.venv/
env/

# ─── Django ───────────────────────────────
backend/staticfiles/
backend/logs/
backend/db.sqlite3
backend/db.sqlite3-journal
backend/db_*.sqlite3
backend/db_*.sqlite3-journal
# Clave Fernet de desarrollo (generada automáticamente por settings.py cuando
# DEBUG=True y no hay ENCRYPTION_KEY en .env). NO debe subirse a git: contiene
# el secreto que cifra datos sensibles (donante_documento, teléfono, tokens).
backend/.dev_key

# ─── Environment ──────────────────────────
.env
.env.local
.env.production
.env.backup-*
!backend/.env.example

# ─── IDE / Editors ────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Node / JS ────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ─── Project specific ─────────────────────
*.bak
*.log

# ─── Archivos Markdown y entornos extra ───
*.md
!README.md
!DEPLOY.md
!CHECKLIST_ENTREGA.md
nombre_del_entorno/

# ─── QA local / herramientas ──────────────
# Estado interno del cliente Freebuff (no es código del proyecto)
.freebuff/
# Artefactos regenerables de QA del correo semanal:
# cd backend && venv/Scripts/python manage.py send_weekly_digest --dry-run
# + render de vista previa (ver CHECKLIST_ENTREGA.md §6)
digest_preview*.html
grafico-mensual.png
# Vista previa regenerable del correo del monitor de disponibilidad:
# cd backend && venv/Scripts/python manage.py check_uptime --dry-run (o render manual)
uptime_preview*.html
