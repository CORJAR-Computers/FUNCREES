{
  "name": "funcrees",
  "version": "2.0.0",
  "private": true,
  "description": "Fundación Crece Una Esperanza Social — Soluciones Sociales Innovadoras para un Impacto Positivo y Duradero. NIT: 902036173-3 | Sincelejo, Sucre, Colombia",
  "type": "module",
  "scripts": {
    "dev": "npm run dev:kill && concurrently --kill-others --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,green\" \"npm run dev:backend\" \"npm run frontend:dev\"",
    "dev:backend": "node scripts/py.mjs backend manage.py runserver 0.0.0.0:8000",
    "dev:kill": "npx kill-port 5173 8000 --yes",
    "start": "npm run frontend:dev",
    "build": "npm run frontend:build",
    "build:all": "npm run frontend:build",
    "start:prod": "npm --prefix frontend run start",
    "check": "npm run frontend:check",
    "test": "npm run frontend:test && npm run backend:test",
    "frontend:dev": "npm --prefix frontend run dev",
    "frontend:build": "npm --prefix frontend run build",
    "frontend:check": "npm --prefix frontend run check",
    "frontend:start": "npm --prefix frontend run start",
    "frontend:test": "node --test frontend/tests/*.test.js",
    "backend:test": "node scripts/py.mjs backend manage.py test --settings=core.test_settings",
    "postinstall": "npm --prefix frontend install"
  },
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.3",
    "jsdom": "^25.0.0"
  }
}
